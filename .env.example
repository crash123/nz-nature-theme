# Copy to .env and set strong, unique values before use.
# Used by both the local dev stack and the Unraid deployment.

# --- Database (MariaDB) ---
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=change-me-db-password

# --- WordPress ---
# Local development URL (Unraid: set to your real https:// domain).
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080

# --- Local stack only ---
# Host port the site is published on during local development.
WP_PORT=8080

# --- Unraid paths (only used by unraid/docker-compose.yml) ---
# Base appdata directory on the Unraid array.
APPDATA=/mnt/user/appdata/nz-nature-theme

# --- Optional: used by scripts/init-wordpress.sh to seed the site ---
SITE_TITLE="NZ Nature"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-admin-password
WP_ADMIN_EMAIL=admin@example.com
