{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "44rem",
			"wideSize": "80rem"
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"palette": [
				{ "slug": "base", "name": "Snow", "color": "#ffffff" },
				{ "slug": "base-2", "name": "Mist", "color": "#f4f7f5" },
				{ "slug": "contrast", "name": "Alpine Slate", "color": "#2b2d42" },
				{ "slug": "pounamu", "name": "Pounamu", "color": "#1b4332" },
				{ "slug": "pounamu-deep", "name": "Deep Pounamu", "color": "#0b2a20" },
				{ "slug": "fern", "name": "Fern", "color": "#2d6a4f" },
				{ "slug": "moss", "name": "Moss", "color": "#40916c" },
				{ "slug": "ocean", "name": "Ocean", "color": "#1d6a96" },
				{ "slug": "glacier", "name": "Glacier", "color": "#48cae4" },
				{ "slug": "kowhai", "name": "Kōwhai", "color": "#e9c46a" },
				{ "slug": "clay", "name": "Clay", "color": "#bc6c25" },
				{ "slug": "sand", "name": "Sand", "color": "#fefae0" },
				{ "slug": "limestone", "name": "Limestone", "color": "#e9edc9" }
			],
			"gradients": [
				{ "slug": "alps-dawn", "name": "Alps Dawn", "gradient": "linear-gradient(180deg, #fefae0 0%, #e9edc9 38%, #40916c 100%)" },
				{ "slug": "fern-canopy", "name": "Fern Canopy", "gradient": "linear-gradient(180deg, #2d6a4f 0%, #0b2a20 100%)" },
				{ "slug": "ocean-deep", "name": "Ocean Deep", "gradient": "linear-gradient(160deg, #48cae4 0%, #1d6a96 55%, #0b2a20 100%)" },
				{ "slug": "kowhai-glow", "name": "Kōwhai Glow", "gradient": "linear-gradient(135deg, #e9c46a 0%, #bc6c25 100%)" },
				{ "slug": "coastline", "name": "Coastline", "gradient": "linear-gradient(180deg, #1d6a96 0%, #48cae4 100%)" }
			],
			"duotone": [
				{ "slug": "pounamu", "name": "Pounamu", "colors": [ "#0b2a20", "#e9edc9" ] },
				{ "slug": "glacier", "name": "Glacier", "colors": [ "#1d6a96", "#fefae0" ] },
				{ "slug": "kowhai", "name": "Kōwhai", "colors": [ "#bc6c25", "#e9c46a" ] }
			]
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"customSpacingSize": true,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "20", "name": "1 · Tight", "size": "0.5rem" },
				{ "slug": "30", "name": "2 · Snug", "size": "1rem" },
				{ "slug": "40", "name": "3 · Regular", "size": "1.5rem" },
				{ "slug": "50", "name": "4 · Relaxed", "size": "2.5rem" },
				{ "slug": "60", "name": "5 · Roomy", "size": "4rem" },
				{ "slug": "70", "name": "6 · Spacious", "size": "6rem" },
				{ "slug": "80", "name": "7 · Vast", "size": "9rem" }
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"lineHeight": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"textDecoration": true,
			"textTransform": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Kōwhai Sans",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "display",
					"name": "Alps Serif",
					"fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "mono",
					"name": "Code",
					"fontFamily": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1rem" },
				{ "slug": "large", "name": "Large", "size": "1.25rem" },
				{ "slug": "x-large", "name": "Extra Large", "size": "1.5rem" },
				{ "slug": "xx-large", "name": "Extra Extra Large", "size": "2.25rem" },
				{ "slug": "xxx-large", "name": "Huge", "size": "3rem" },
				{ "slug": "mega", "name": "Mega", "size": "clamp(3rem, 8vw, 5.5rem)" }
			]
		},
		"custom": {
			"radius": {
				"small": "6px",
				"medium": "14px",
				"large": "28px",
				"pill": "999px"
			},
			"shadow": {
				"soft": "0 12px 30px -18px rgba(11, 42, 32, 0.55)",
				"card": "0 24px 60px -30px rgba(11, 42, 32, 0.45)"
			},
			"line": {
				"hairline": "1px solid"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base-2",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.75rem",
			"padding": {
				"top": "0",
				"right": "var:preset|spacing|40",
				"bottom": "0",
				"left": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.7",
			"letterSpacing": "0.01em"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|fern" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var:preset|color|ocean" },
					"typography": { "textDecoration": "none" }
				}
			},
			"heading": {
				"color": { "text": "var:preset|color|pounamu-deep" },
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "600",
					"lineHeight": "1.15",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"button": {
				"border": { "radius": "999px" },
				"color": {
					"background": "var:preset|color|pounamu",
					"text": "var:preset|color|base"
				},
				"typography": {
					"fontWeight": "600",
					"letterSpacing": "0.02em"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|fern",
						"text": "var:preset|color|base"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontStyle": "italic"
				},
				"color": { "text": "var:preset|color|fern" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "700",
					"fontSize": "var:preset|font-size|large",
					"letterSpacing": "0.02em"
				}
			},
			"core/site-tagline": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				},
				"color": { "text": "var:preset|color|fern" }
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600",
					"letterSpacing": "0.04em",
					"textTransform": "uppercase"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|kowhai",
						"width": "4px",
						"style": "solid"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|large",
					"fontStyle": "italic"
				},
				"spacing": { "padding": { "left": "var:preset|spacing|40" } }
			},
			"core/post-title": {
				"typography": { "fontFamily": "var:preset|font-family|display" }
			},
			"core/post-featured-image": {
				"border": { "radius": "14px" }
			},
			"core/image": {
				"border": { "radius": "14px" }
			},
			"core/code": {
				"typography": { "fontFamily": "var:preset|font-family|mono" },
				"color": { "background": "var:preset|color|pounamu-deep", "text": "var:preset|color|limestone" },
				"border": { "radius": "6px" },
				"spacing": { "padding": { "top": "var:preset|spacing|30", "bottom": "var:preset|spacing|30", "left": "var:preset|spacing|30", "right": "var:preset|spacing|30" } }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|moss" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page (no title)", "postTypes": [ "page" ] },
		{ "name": "blank", "title": "Blank canvas", "postTypes": [ "page", "post" ] }
	]
}
